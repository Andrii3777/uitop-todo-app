{
  "name": "uitop-todo-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:unit": "cd apps/backend && pnpm test",
    "test:e2e": "cd apps/backend && pnpm test:e2e",
    "test:frontend": "cd apps/frontend && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/swagger": "^11.4.4"
  }
}
